# Copy to .env (gitignored) and adjust. direnv picks .env up via `dotenv` in .envrc.
# Every var here is also readable straight from the shell - params.yaml resolves
# ${VAR} at load time and treats an empty value as unset.

# Database
POSTGRES_USER=healthcard
POSTGRES_PASSWORD=healthcard            # pragma: allowlist secret
POSTGRES_DB=healthcard
DATABASE_URL=postgresql://healthcard:healthcard@127.0.0.1:5433/healthcard  # pragma: allowlist secret

# MLflow. Unset -> params.yaml falls back to a local file store (./mlruns).
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# API
LOG_LEVEL=INFO
LOG_TARGET=file                         # `stdout` in containers -> no file handler
# LOG_FORMAT=console                    # force console/json instead of tty detection
WORKERS=4
# HEALTHCARD_API_KEY=                   # set -> X-API-Key required on /api/*
# RATE_LIMIT_TRUST_FORWARDED=1          # only behind a proxy that OVERWRITES X-Forwarded-For
# CORS_ALLOW_ORIGINS=http://localhost:3000
# API_ROOT_PATH=/healthcard             # when served behind a path-stripping proxy

# S3 / DVC remote (optional)
# AWS_PROFILE=
# AWS_REGION=ap-south-1
